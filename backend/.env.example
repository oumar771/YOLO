# Serveur
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Base de données
DATABASE_URL=sqlite:///./attendance.db
# Ou pour PostgreSQL: postgresql://user:password@localhost/dbname
# Ou pour MongoDB: mongodb://localhost:27017/attendance

# JWT et sécurité
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# YOLO Models
YOLO_FACE_MODEL=yolov8n-face.pt
YOLO_WEAPON_MODEL=yolov8n-weapons.pt
YOLO_ANIMAL_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Reconnaissance faciale
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MODEL=hog  # ou cnn pour plus de précision
USE_INSIGHTFACE=True
INSIGHTFACE_MODEL=buffalo_l

# Azure Cloud Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER_NAME=face-recognition
AZURE_COSMOS_ENDPOINT=your-cosmos-endpoint
AZURE_COSMOS_KEY=your-cosmos-key
AZURE_COSMOS_DATABASE_NAME=attendance_db

# Notifications
SENDGRID_API_KEY=your-sendgrid-api-key
HR_EMAIL=hr@company.com
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-phone

# Auto-apprentissage
ENABLE_AUTO_LEARNING=True
MIN_IMAGES_FOR_TRAINING=50
TRAINING_EPOCHS=100
BATCH_SIZE=16
AUTO_TRAIN_SCHEDULE=0 2 * * *  # Tous les jours à 2h du matin

# Stockage local
LOCAL_STORAGE_PATH=./storage
OFFLINE_MODE=True
SYNC_INTERVAL_MINUTES=5

# Logs
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
